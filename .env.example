# Create a personal API token at https://www.start.gg/admin/profile/developer
# and keep it local. This value is read only by the Node server.
# Optional: the dashboard can also save the token to the current user's local
# configuration file on first launch.
STARTGG_API_TOKEN=

PORT=3100
POLL_INTERVAL_MS=15000
STATE_FILE=.data/operator-state.json
# CONFIG_FILE=/custom/path/config.json
# PUBLIC_DIRECTORY=/custom/path/public
# OPEN_BROWSER=false
